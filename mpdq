VERSION=2.4.4

# This is an awful hack
if [ "$UID" == "0" ];then
    loud "MPDQ is running as root. Note that /usr/local/share and"
    loud "/usr/local/state are being used as XDG directories."
    export XDG_CONFIG_HOME=/usr/local/share
    export XDG_STATE_HOME=/usr/local/state
fi



# Global variables
export SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# Setting them here, will create if needed later
 if [ -w "${SCRIPT_DIR}/config" ]; then
      ConfigDir="${SCRIPT_DIR}/config"
  elif [ -n "${XDG_CONFIG_HOME}" ]; then
      ConfigDir="${XDG_CONFIG_HOME}/mpdq"
  else
      ConfigDir="$HOME/.config/mpdq"
  fi
 if [ -w "${SCRIPT_DIR}/local/state" ]; then
      StateDir="${SCRIPT_DIR}/local/state"
  elif [ -n "${XDG_STATE_HOME}" ]; then
      StateDir="${XDG_STATE_HOME}/mpdq"
  else
      StateDir="$HOME/.local/state/mpdq"
  fi
 if [ -w "${SCRIPT_DIR}/cache" ]; then
      CacheDir="${SCRIPT_DIR}/cache"
  elif [ -n "${XDG_CACHE_HOME}" ]; then
      CacheDir="${XDG_CACHE_HOME}/mpdq"
  else
      CacheDir="$HOME/.cache/mpdq"
  fi
  if [ -f "${SCRIPT_DIR}/mpdq.ini" ]; then
      ConfigFile="${SCRIPT_DIR}/mpdq.ini"
  else
      ConfigFile="${ConfigDir}/mpdq.ini"
  fi

# Defining some things. This is NOT the instruction file.
# This file will contain time song was played, its filename, the album, and artist
ConfigLogFile=${StateDir}/playedsongs.log
ConfigLogFile2=${StateDir}/playedsongs2.log
grep_bin=$(which grep)
MPDBASE=""
MPD_HOST=""
MPD_PASS=""
MPD_PORT=""
# How long the playlist should be
PLAYLIST_TRIGGER=""
# How long before a song/genre gets purged from the log, IN HOURS
ROTATE_TIME=""
# Longest time to not hear a song again. Must be LONGER than MAXIMUM "no repeat"
# time for album and artist
NOREPLAY_ROTATE_TIME=""
# How long before a particular album or artist can be played again. SEPARATE
# from the main log, and should be SHORTER than NO_REPLAY_TIME. IN MINUTES  These
# will be checked
# dynamically against the current logfile for thier individual time periods.
ALBUM_MINS=""
ARTIST_MINS=""
# How long a song can be to be considered for the queue, in minutes
SONGLENGTH=""
# What tool to use to get song length
MUSICINFO=""
# Where you're getting instructions from
InstructionFile=""
# Default priorities for selector weights
DefaultPriority=1
GenreDefaultPriority=1
AlbumArtistDefaultPriority=1
AlbumDefaultPriority=1
NUMGENRES=""
NUMSELECTORS=0
# noisy feedback or not?
LOUD=0
# if we have exhausted all available options, shorten logrotate time temporarily
EMERGENCY_ROTATE=0
# If we are doing local file checks (e.g. to use on a remote machine!)
REMOTE=0
QUEUE_TIME_OFFSET=0
# initialize choosing array
export ChooseGenre=()
host_arg=""


########################################################################
# Temporary Directories
########################################################################

SongFileToAdd=""

########################################################################
# Functions
########################################################################

function loud() {
    if [ $LOUD -eq 1 ];then
        echo "$@"
    fi
}

function already_running {
    if [ -f "${StateDir}"/mpdq.pid ];then
        checkpid=$(head -n 1 "${StateDir}"/mpdq.pid)
        bob=$(ps aux | grep -e " ${checkpid} "| grep -c "mpdq")
        if [ "${bob}" -gt 0 ];then
            loud "mpdq is already running with PID ${checkpid}." >&2
            exit 97
        else
            loud "stale mpdq.pid file found, deleting"
            rm -rf "${StateDir}"/mpdq.pid
        fi
    fi
}

function show_help {
    echo "mpdq [-c /path/to/file|--config /path/to/file|-c station_name|--config station_name] [-s station_name|--station station_name] [--album-mins MINUTES] [--artist-mins MINUTES] [-e|--enumerate] [-f|--force] [-h|--help] [-l|--loud] [--noreplay HOURS] [-r|--reset] [--rotate HOURS] [-v|--version] [-x|--example]"
    echo "  -c, --config FILE      copy an instruction file from any path to default.cfg"
    echo "  -c, --config STATION   change to a station config by name, or choose interactively"
    echo "  -s, --station STATION  change to a station config by name, or choose interactively"
    echo "      --album-mins MIN   override album replay delay in minutes for this run"
    echo "      --artist-mins MIN  override artist replay delay in minutes for this run"
    echo "  -e, --enumerate        enumerate station configs visible to mpdq"
    echo "  -f, --force            force MPD to have the right playback settings"
    echo "  -h, --help             show this help message"
    echo "  -l, --loud      get more feedback on mpdq's execution"
    echo "      --noreplay HOURS   override no-replay window in hours for this run"
    echo "  -r, --reset            clear played-song logs immediately"
    echo "      --rotate HOURS     override genre rotation window in hours for this run"
    echo "  -v, --version          show version"
    echo "  -x, --example          create default_example.cfg with all genres"
}

function show_version() {
    echo "mpdq ${VERSION}"
}

function missing_option_argument() {
    echo "Missing argument for ${1}" >&2
    exit 1
}

function unknown_option() {
    echo "Unknown option: ${1}" >&2
    exit 1
}

function reset_logs() {
    : > "${ConfigLogFile}"
    : > "${ConfigLogFile2}"
    loud "Reset played-song logs"
    exit
}

function init_config() {
    if [ ! -d "$ConfigDir" ];then
        mkdir -p "$ConfigDir"
    fi
    if [ ! -d "$StateDir" ];then
        mkdir -p "$StateDir"
    fi

    if [ ! -d "$CacheDir" ];then
        mkdir -p "$CacheDir"
    fi
    if [ ! -f "$ConfigLogFile" ];then
        touch "$ConfigLogFile"
    fi
    if [ ! -f "$ConfigLogFile2" ];then
        touch "$ConfigLogFile2"
    fi

}

function read_variables() {
    if [ -f "$ConfigFile" ];then
        config=$(cat "$ConfigFile")
    else
        loud "Configuration file not found; using defaults."
    fi
    # If there's no config file or a line is malformed or missing, sub in the default value

    MPDBASE="$(echo "$config" | ${grep_bin} -e "^musicdir=" | cut -d = -f 2- ||
        cat "$XDG_CONFIG_HOME/mpd/mpd.conf" | ${grep_bin} "^music" | cut -d'"' -f2 ||
        echo $HOME/Music)"
    MPD_HOST="$(echo "$config" | ${grep_bin} -e "^mpdserver=" | cut -d = -f 2- || echo localhost)"
    MPD_PASS=$(echo "$config" | ${grep_bin} -e "^mpdpass=" | cut -d = -f 2-)
    MPD_PORT=$(echo "$config" | ${grep_bin} -e "^mpdport=" | cut -d = -f 2- || echo 6600)

    if [[ `echo "$config" | ${grep_bin} -c -e "^queuesize="` -gt 0 ]];then PLAYLIST_TRIGGER=$(echo "$config" | ${grep_bin} -e "^queuesize=" | cut -d = -f 2- );else PLAYLIST_TRIGGER="10";fi
    if [[ `echo "$config" | ${grep_bin} -c -e "^rotate_time="` -gt 0 ]];then ROTATE_TIME=$(echo "$config" | ${grep_bin} -e "^rotate_time=" | cut -d = -f 2- );else ROTATE_TIME="8";fi
    if [[ `echo "$config" | ${grep_bin} -c -e "^no_replay_rotate="` -gt 0 ]];then NOREPLAY_ROTATE_TIME=$(echo "$config" | ${grep_bin} -e "^no_replay_rotate=" | cut -d = -f 2- );else NOREPLAY_ROTATE_TIME="8";fi
    if [[ `echo "$config" | ${grep_bin} -c -e "^album_mins="` -gt 0 ]];then ALBUM_MINS=$(echo "$config" | ${grep_bin} -e "^album_mins=" | cut -d = -f 2- );else ALBUM_MINS="15";fi
    if [[ `echo "$config" | ${grep_bin} -c -e "^artist_mins="` -gt 0 ]];then ARTIST_MINS=$(echo "$config" | ${grep_bin} -e "^artist_mins=" | cut -d = -f 2- );else ARTIST_MINS="15";fi
    if [[ `echo "$config" | ${grep_bin} -c -e "^songlength="` -gt 0 ]];then SONGLENGTH=$(echo "$config" | ${grep_bin} -e "^songlength=" | cut -d = -f 2- );else SONGLENGTH="15";fi
    if [[ `echo "$config" | ${grep_bin} -c -e "^remote="` -gt 0 ]];then REMOTE=$(echo "$config" | ${grep_bin} -e "^remote=" | cut -d = -f 2- );else REMOTE="0";fi

    # Determining where/how to assess song length
    if [[ `echo "$config" | ${grep_bin} -c -e "^musicinfo="` -gt 0 ]];then
        MUSICINFO=$(echo "$config" | ${grep_bin} -e "^musicinfo=" | cut -d = -f 2- )
    else
        if [ -f $(which ffprobe) ];then
            MUSICINFO=ffprobe
        else
            if [ -f $(which exiftool) ];then
                MUSICINFO=exiftool
            else
                if [ -f $(which mp3info) ];then
                    MUSICINFO=mp3info
                else
                    MUSICINFO=""
                fi
            fi
        fi
    fi
    set_host_arg
    NUMGENRES=$(mpc --host "${host_arg}" --port "${MPD_PORT}" list genre | wc -l)

}

function set_host_arg() {
    # in case the password is already set in environment
    if [ -n "$MPD_PASS" ] && [ "$MPD_HOST" != *"@"* ]; then
        host_arg="$MPD_PASS@$MPD_HOST"
    else
        host_arg="$MPD_HOST"
    fi
}

function load_instruction_defaults() {
    if [ -f "${InstructionFile}" ];then
         DefaultPriority=$(${grep_bin} -i -e "^Default=" "${InstructionFile}" | cut -d = -f 2-)
        if [ "$DefaultPriority" == "" ];then
            DefaultPriority=0
        fi
        lookup_instruction_weight "Genre:Default"
        if [ "${LookupWeight}" == "" ];then
            GenreDefaultPriority="${DefaultPriority}"
        else
            GenreDefaultPriority="${LookupWeight}"
        fi
        lookup_instruction_weight "AlbumArtist:Default"
        if [ "${LookupWeight}" == "" ];then
            AlbumArtistDefaultPriority="${DefaultPriority}"
        else
            AlbumArtistDefaultPriority="${LookupWeight}"
        fi
        lookup_instruction_weight "Album:Default"
        if [ "${LookupWeight}" == "" ];then
            AlbumDefaultPriority="${DefaultPriority}"
        else
            AlbumDefaultPriority="${LookupWeight}"
        fi
    else
        DefaultPriority=1
        GenreDefaultPriority=1
        AlbumArtistDefaultPriority=1
        AlbumDefaultPriority=1
    fi
}

function lookup_instruction_setting() {
    setting_name="${1}"
    SettingValue=""
    if [ -f "${InstructionFile}" ];then
        SettingValue=$(awk -F '=' -v target="Setting:${setting_name}" '
            tolower($1) == tolower(target) {
                value = substr($0, index($0, "=") + 1)
            }
            END {
                print value
            }
        ' "${InstructionFile}")
    fi
}

function load_instruction_settings() {
    lookup_instruction_setting "ROTATE_TIME"
    if [ "${SettingValue}" != "" ];then
        ROTATE_TIME="${SettingValue}"
    fi

    lookup_instruction_setting "NOREPLAY_ROTATE_TIME"
    if [ "${SettingValue}" != "" ];then
        NOREPLAY_ROTATE_TIME="${SettingValue}"
    fi

    lookup_instruction_setting "ALBUM_MINS"
    if [ "${SettingValue}" != "" ];then
        ALBUM_MINS="${SettingValue}"
    fi

    lookup_instruction_setting "ARTIST_MINS"
    if [ "${SettingValue}" != "" ];then
        ARTIST_MINS="${SettingValue}"
    fi
}

function parse_selector_key() {
    rawkey="${1}"
    SelectorField=""
    SelectorValue=""
    SelectorName=""
    if [[ "${rawkey}" == Genre:* ]];then
        SelectorField="Genre"
        SelectorValue="${rawkey#Genre:}"
        SelectorName="Genre:${SelectorValue}"
    elif [[ "${rawkey}" == AlbumArtist:* ]];then
        SelectorField="AlbumArtist"
        SelectorValue="${rawkey#AlbumArtist:}"
        SelectorName="AlbumArtist:${SelectorValue}"
    elif [[ "${rawkey}" == Album:* ]];then
        SelectorField="Album"
        SelectorValue="${rawkey#Album:}"
        SelectorName="Album:${SelectorValue}"
    else
        SelectorField="Genre"
        SelectorValue="${rawkey}"
        SelectorName="Genre:${SelectorValue}"
    fi
}

function lookup_instruction_weight() {
    target1="${1}"
    target2="${2:-}"
    LookupWeight=""
    if [ -f "${InstructionFile}" ];then
        LookupWeight=$(awk -F '=' -v target1="${target1}" -v target2="${target2}" '
            {
                lowered_key = tolower($1)
                lowered_target1 = tolower(target1)
                lowered_target2 = tolower(target2)
            }
            (lowered_key == lowered_target1 || (target2 != "" && lowered_key == lowered_target2)) {
                weight = substr($0, index($0, "=") + 1)
            }
            END {
                print weight
            }
        ' "${InstructionFile}")
    fi
}

function selector_weight_from_name() {
    parse_selector_key "${1}"
    if [ "${SelectorField}" == "Genre" ];then
        lookup_instruction_weight "Genre:${SelectorValue}" "${SelectorValue}"
        if [ "${LookupWeight}" == "" ];then
            CurrWeight="${GenreDefaultPriority}"
        else
            CurrWeight="${LookupWeight}"
        fi
    elif [ "${SelectorField}" == "AlbumArtist" ];then
        lookup_instruction_weight "${SelectorName}"
        if [ "${LookupWeight}" == "" ];then
            CurrWeight="${AlbumArtistDefaultPriority}"
        else
            CurrWeight="${LookupWeight}"
        fi
    else
        lookup_instruction_weight "${SelectorName}"
        if [ "${LookupWeight}" == "" ];then
            CurrWeight="${AlbumDefaultPriority}"
        else
            CurrWeight="${LookupWeight}"
        fi
    fi
}

function selector_has_explicit_zero_weight() {
    selector_name="${1}"
    parse_selector_key "${selector_name}"
    if [ "${SelectorField}" == "Genre" ];then
        lookup_instruction_weight "Genre:${SelectorValue}" "${SelectorValue}"
    else
        lookup_instruction_weight "${SelectorName}"
    fi
    if [ "${LookupWeight}" == "0" ];then
        loud "Rejected by zero-weight selector ${selector_name}"
        return 0
    fi
    return 1
}

function add_selector_to_pool() {
    selector_to_add="${1}"
    selector_weight="${2}"
    i=1
    loud "Adding ${selector_weight}:${selector_to_add}"
    while [ $i -le $selector_weight ];do
        ChooseGenre+=("${selector_to_add}")
        ((i++))
    done
}

function count_selector_plays() {
    parse_selector_key "${1}"
    TimesPlayed=$(awk -F '@@@' -v target="${SelectorName}" -v legacy="${SelectorValue}" -v selector_field="${SelectorField}" '
        {
            split($2, parts, "@")
            selector = tolower(parts[2])
            lowered_target = tolower(target)
            lowered_legacy = tolower(legacy)
            if (selector == lowered_target || (selector_field == "Genre" && selector == lowered_legacy)) {
                count++
            }
        }
        END {
            print count + 0
        }
    ' "${ConfigLogFile}")
}

function selector_query_tag() {
    if [ "${1}" == "AlbumArtist" ];then
        echo "albumartist"
    elif [ "${1}" == "Album" ];then
        echo "album"
    else
        echo "genre"
    fi
}

function duration_to_seconds() {
    duration_text="${1}"
    DurationSeconds=$(echo "${duration_text}" | awk -F ':' '
        {
            total = 0
            for (i = 1; i <= NF; i++) {
                total = (total * 60) + $i
            }
            print total
        }
    ')
}

function init_queue_time_offset() {
    QUEUE_TIME_OFFSET=0
    playlist_times=$(mpc --host "${host_arg}" --port "${MPD_PORT}" --format "%time%" playlist)
    if [ "${playlist_times}" == "" ];then
        return
    fi

    status_line=$(mpc --host "${host_arg}" --port "${MPD_PORT}" | sed -n '2p')
    if [[ "${status_line}" == *"[playing]"* ]] || [[ "${status_line}" == *"[paused]"* ]];then
        status_time=$(echo "${status_line}" | awk '{
            for (i = 1; i <= NF; i++) {
                if ($i ~ /[0-9]+:[0-9]+\/[0-9]+:[0-9]+/ || $i ~ /[0-9]+:[0-9]+:[0-9]+\/[0-9]+:[0-9]+:[0-9]+/) {
                    print $i
                    exit
                }
            }
        }')
        elapsed_time="${status_time%%/*}"
        total_time="${status_time##*/}"
        duration_to_seconds "${elapsed_time}"
        elapsed_seconds="${DurationSeconds}"
        duration_to_seconds "${total_time}"
        total_seconds="${DurationSeconds}"
        remaining_seconds=$(( total_seconds - elapsed_seconds ))
        if [ ${remaining_seconds} -lt 0 ];then
            remaining_seconds=0
        fi
        QUEUE_TIME_OFFSET=$(( QUEUE_TIME_OFFSET + remaining_seconds ))
        playlist_times=$(echo "${playlist_times}" | sed -n '2,$p')
    fi

    while read -r queue_duration; do
        if [ "${queue_duration}" != "" ];then
            duration_to_seconds "${queue_duration}"
            QUEUE_TIME_OFFSET=$(( QUEUE_TIME_OFFSET + DurationSeconds ))
        fi
    done <<< "${playlist_times}"
}

function resolve_selector_query_value() {
    selector_field="${1}"
    selector_value="${2}"
    ResolvedSelectorValue=""
    QueryTag=$(selector_query_tag "${selector_field}")
    ResolvedSelectorValue=$(mpc --host "${host_arg}" --port "${MPD_PORT}" list "${QueryTag}" | awk -v target="${selector_value}" '
        tolower($0) == tolower(target) {
            print
            exit
        }
    ')
    if [ "${ResolvedSelectorValue}" == "" ];then
        ResolvedSelectorValue="${selector_value}"
    fi
}

function selector_is_eligible() {
    selector_candidate="${1}"
    EligibleSongFile=""
    EligibleSongStem=""
    EligibleAlbum=""
    EligibleArtist=""
    EligibleGenre=""
    EligibleLength=0

    parse_selector_key "${selector_candidate}"
    if [ "${SelectorName}" == "" ] || { [ "${SelectorField}" == "Genre" ] && { [ "${SelectorValue}" == "Bumper" ] || [ "${SelectorValue}" == "Sound Clip" ]; }; };then
        return 1
    fi

    count_selector_plays "${SelectorName}"
    selector_weight_from_name "${SelectorName}"
    if [[ ${TimesPlayed} -ge ${CurrWeight} ]];then
        loud "Used up ${SelectorName}"
        return 1
    fi

    resolve_selector_query_value "${SelectorField}" "${SelectorValue}"
    QueryTag=$(selector_query_tag "${SelectorField}")
    EligibleSongStem=$(mpc --host "${host_arg}" --port "${MPD_PORT}" find "${QueryTag}" "${ResolvedSelectorValue}" | shuf -n1 )
    if [ "${EligibleSongStem}" == "" ];then
        loud "No tracks found for ${SelectorName}"
        return 1
    fi

    EligibleSongFile="$MPDBASE/$EligibleSongStem"
    SongInfo=$(mpc --format "%time%§%album%§%albumartist%§%genre%" --host "${host_arg}" --port "${MPD_PORT}" find filename "${EligibleSongStem}")
    SongDuration=$(echo "${SongInfo}" | awk -F '§' '{print $1 }')
    duration_to_seconds "${SongDuration}"
    EligibleLength="${DurationSeconds}"
    EligibleAlbum=$(echo "${SongInfo}" | awk -F '§' '{print $2 }' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    EligibleArtist=$(echo "${SongInfo}" | awk -F '§' '{print $3 }' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    EligibleGenre=$(echo "${SongInfo}" | awk -F '§' '{print $4 }' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    if [ -z "${EligibleLength}" ];then
        loud "No song duration found from mpc/mpd."
        EligibleLength=0
    fi
    if [ ${EligibleLength} -gt $(( SONGLENGTH * 60 )) ];then
        loud "Song too long; kicking back"
        return 1
    fi
    if [ "$REMOTE" == "0" ] && [ ! -f "${EligibleSongFile}" ];then
        return 1
    fi

    if [ "${EligibleGenre}" != "" ] && selector_has_explicit_zero_weight "Genre:${EligibleGenre}";then
        return 1
    fi
    if [ "${EligibleArtist}" != "" ] && selector_has_explicit_zero_weight "AlbumArtist:${EligibleArtist}";then
        return 1
    fi
    if [ "${EligibleAlbum}" != "" ] && selector_has_explicit_zero_weight "Album:${EligibleAlbum}";then
        return 1
    fi

    DontCheckAlbumOrArtistTime=$(sed -n /^genres_exclude_album_check=/p "${ConfigFile}" | cut -d = -f 2-)
    if [[ "${DontCheckAlbumOrArtistTime,,}" != *"${EligibleGenre,,}"* ]];then
        currenttime=$(TZ=UTC0 printf '%(%s)T\n' '-1')
        currenttime=$(( currenttime + QUEUE_TIME_OFFSET ))
        difftime=$(( "$ARTIST_MINS" * 60 ))
        difftime2=$(( "$ALBUM_MINS" * 60 ))
        if [ ${EMERGENCY_ROTATE} -ne 0 ];then
            difftime=$(( "$difftime" / ( 4 * "$EMERGENCY_ROTATE" ) ))
            difftime2=$(( "$difftime2" / ( 4 * "$EMERGENCY_ROTATE" ) ))
        fi
        hightime=$(( "$currenttime"-"$difftime" ))
        hightime2=$(( "$currenttime"-"$difftime2" ))
        if [[ `cat "$ConfigLogFile2" | awk -F '@@@' -v hightime="$hightime" '$1 > hightime' | grep -i -e "@${EligibleArtist}@" | wc -l` -gt 0 ]];then echo "Artist found in log: ${EligibleArtist}"; return 1;fi
        if [[ `cat "$ConfigLogFile2" | awk -F '@@@' -v hightime="$hightime2" '$1 > hightime' | grep -i -e "@#${EligibleAlbum}@" | wc -l` -gt 0 ]] ;then echo "Album found in log: ${EligibleAlbum}"; return 1;fi
        if [[ `cat "$ConfigLogFile2" | grep -i -e "@#${EligibleSongFile}@" | wc -l` -gt 0 ]] ;then echo "Song found in log: ${EligibleAlbum}"; return 1;fi
    fi

    return 0
}

function build_eligible_selector_pool() {
    EligibleSelectors=()
    unique_selectors=$(printf '%s\n' "${ChooseGenre[@]}" | awk '!seen[$0]++')
    while read -r selector_candidate; do
        if [ "${selector_candidate}" == "" ];then
            continue
        fi
        if selector_is_eligible "${selector_candidate}";then
            count=0
            while [ $count -lt ${#ChooseGenre[@]} ];do
                if [ "${ChooseGenre[$count]}" == "${selector_candidate}" ];then
                    EligibleSelectors+=("${selector_candidate}")
                fi
                count=$(( count + 1 ))
            done
        fi
    done <<< "${unique_selectors}"
}

function load_choose_genre() {
    ChooseGenre=()
    NUMGENRES=0
    NUMSELECTORS=0
    loud "Loading instruction file commands"
    # go through list of genres from mpc/mpd
    while read -r line; do
        parse_selector_key "${line}"
        selector_weight_from_name "${SelectorName}"
        NUMGENRES=$(( NUMGENRES + 1 ))
        add_selector_to_pool "${SelectorName}" "${CurrWeight}"
    done < <(mpc --host "${host_arg}" --port "${MPD_PORT}" list genre)

    if [ -f "${InstructionFile}" ];then
        while read -r line; do
            selector_name="${line%%=*}"
            selector_weight="${line#*=}"
            loud "Found instruction selector ${selector_name} with weight ${selector_weight}"
            NUMGENRES=$(( NUMGENRES + 1 ))
            add_selector_to_pool "${selector_name}" "${selector_weight}"
        done < <(awk -F '=' '
            tolower($1) ~ /^albumartist:/ || tolower($1) ~ /^album:/ {
                entries[$1] = substr($0, index($0, "=") + 1)
            }
            END {
                for (entry in entries) {
                    print entry "=" entries[entry]
                }
            }
        ' "${InstructionFile}")
    fi

    if [ ${#ChooseGenre[@]} -eq 0 ];then
        echo "No weighted selectors available from ${InstructionFile}" >&2
        exit 96
    fi
    NUMSELECTORS=${#ChooseGenre[@]}
}

function rotate_songlog {

    if [ -f "$ConfigLogFile" ];then
        tempfile=$(mktemp)
        currenttime=$(TZ=UTC0 printf '%(%s)T\n' '-1')
        difftime=$(( "$ROTATE_TIME" * 60 * 60 ))
        # Cuts the diff time further each time we exhaust all options
        if [ ${EMERGENCY_ROTATE} -ne 0 ];then
            difftime=$(( "$difftime" / ( 4 * "$EMERGENCY_ROTATE" ) ))
        fi
        hightime=$(( "$currenttime"-"$difftime" ))
        loud "Eliminating song log entries older than $ROTATE_TIME hours."
        #echo "$hightime / $difftime"
        cat "$ConfigLogFile" | awk -F '@@@' -v hightime="$hightime" '$1 > hightime'  > "$tempfile"
        mv -f "$tempfile" "$ConfigLogFile"
    else
        touch "$ConfigLogFile"
    fi
    if [ -f "$ConfigLogFile2" ];then
        tempfile=$(mktemp)
        currenttime=$(TZ=UTC0 printf '%(%s)T\n' '-1')
        difftime=$(( "$NOREPLAY_ROTATE_TIME" * 60 * 60 ))
        # Cuts the diff time further each time we exhaust all options
        if [ ${EMERGENCY_ROTATE} -ne 0 ];then
            difftime=$(( "$difftime" / ( 4 * "$EMERGENCY_ROTATE" ) ))
        fi
        hightime=$(( "$currenttime"-"$difftime" ))
        loud "Eliminating song log entries older than $NOREPLAY_ROTATE_TIME hours."
        #echo "$hightime / $difftime"
        cat "$ConfigLogFile2" | awk -F '@@@' -v hightime="$hightime" '$1 > hightime'  > "$tempfile"
        mv -f "$tempfile" "$ConfigLogFile2"
    else
        touch "$ConfigLogFile2"
    fi

}

function create_example(){
    ExampleFile="$ConfigDir/default_example.cfg"
    set_host_arg
    echo "Default=1" > "${ExampleFile}"
    mpc --host "${host_arg}" --port "${MPD_PORT}" list genre | sed 's/$/=1/' >> "${ExampleFile}"
    loud "Example config placed at ${ExampleFile}"
    exit
}

function enumerate_configs() {
    find "${ConfigDir}" -type f -name '*.cfg' | while read -r configfile; do
        configbase=$(basename "${configfile}")
        if [ "${configbase}" != "default.cfg" ] && [ "${configbase}" != "default_example.cfg" ];then
            echo "${configfile}"
        fi
    done
    exit
}

function set_config_file {
    newconfig="${1}"
    if [ -f "${newconfig}" ];then
        loud "[info] Setting default config from ${newconfig}"
        cp "${newconfig}" "${ConfigDir}/default.cfg"
        InstructionFile="${ConfigDir}/default.cfg"
    fi
}

function killing(){
    # This is probably overkill at this point, as we are avoiding subprocesses.
    while read VPID; do
        if [ $VPID != "$$" ];then
            kill -9 "$VPID" &> /dev/null
        fi
    done < /tmp/mpdq.pid
    rm /tmp/mpdq.pid

    exit
}

function change_station {
	newstation="${1}"
	if [ -f "${ConfigDir}/${newstation}.cfg" ]; then
			loud "[info] Wiping songlogs"
			echo "" > "${ConfigLogFile}"
			echo "" > "${ConfigLogFile2}"
			set_host_arg
			loud "[info] Changing station to ${newstation}"
			cp "${ConfigDir}/${newstation}.cfg" "${ConfigDir}/default.cfg"
            InstructionFile="${ConfigDir}/default.cfg"
            load_instruction_defaults
            load_instruction_settings
            load_choose_genre
			mpc --host "${host_arg}" --port "${MPD_PORT}" crop
	        # if there is anything in genre "Bumper" then choose one randomly and add it.
	        SongStem=$(mpc --host "${host_arg}" --port "${MPD_PORT}" find genre "Bumper" | shuf -n1 )
	        if [ "$SongStem" != "" ];then
	            # We will also use $SongFile as a continuing check
	            SongFile="$MPDBASE/$SongStem"
	            `mpc --host "${host_arg}" --port "${MPD_PORT}" add "${SongStem}"`
        fi
            init_queue_time_offset
			playlist_length=$(mpc --host "$host_arg" --port "$MPD_PORT" playlist | wc -l)

			while [[ $playlist_length -lt $PLAYLIST_TRIGGER ]]; do
				need_next_song
				playlist_length=$(mpc --host "$host_arg" --port "$MPD_PORT" playlist | wc -l)
			done
        exit 0
	else
		if [ -f $(which fzf) ];then
selected="$(
    find "${ConfigDir}" -type f -name '*.cfg' -printf '%p\t%f\n' |
        grep -Ev 'default\.cfg|sync|example' |
        awk -F $'\t' '{
            display = $2
            sub(/\.[^.]*$/, "", display)
            print $1 "\t" display
        }' |
        fzf \
            --delimiter=$'\t' \
            --with-nth=2 \
            --preview='cat {1}' \
            --preview-window='right:60%:wrap'
)"

			selected_file="${selected%%$'\t'*}"
			answer2=$(basename "${selected_file}")
			change_station ${answer2%%.*}
		else
			loud "[ERROR] ${newstation} not found!"
		fi
	fi
}


function choose_next_song {

    SongFileToAdd=""
    OkayGenre=""


## NEED TO CHECK FOR SPLIT AND WHITESPACE FOR GENRE NAMES
    counter=1 # this is so that if we go through ALL the genres in an hour, it'll just go ahead anyway

    while [ -z "${OkayGenre}" ] && [ ${counter} -le ${NUMSELECTORS} ]
    do
        OIFS=$IFS
        IFS=$'\n'

        loud "Search run ${counter} of ${NUMSELECTORS}"
        build_eligible_selector_pool
        if [ ${#EligibleSelectors[@]} -gt 0 ];then
            GenreNumber=$(shuf -i 0-$((${#EligibleSelectors[@]} - 1)) -n 1)
            SelectorName="${EligibleSelectors[$GenreNumber]}"
            loud "Examining ${SelectorName}"
            selector_is_eligible "${SelectorName}"
            SongFile="${EligibleSongFile}"
            SongStem="${EligibleSongStem}"
            album="${EligibleAlbum}"
            artist="${EligibleArtist}"
            SongGenre="${EligibleGenre}"
            length="${EligibleLength}"
        else
            SongFile=""
        fi
	        if [ "${SongFile}" != "" ];then  # if it hasn't been rejected            # adding to logfile here because we have the function variables here
	            SongFileToAdd="$SongFile"
                EMERGENCY_ROTATE=0
	            #mark that we used it.
	            nowtime=$(TZ=UTC0 printf '%(%s)T\n' '-1')
                nowtime=$(( nowtime + QUEUE_TIME_OFFSET ))
            echo "$nowtime@@@${SongFileToAdd}@${SelectorName}@${artist}@#${album}" >> "$ConfigLogFile"
            echo "$nowtime@@@${SongFileToAdd}@${SelectorName}@${artist}@#${album}" >> "$ConfigLogFile2"
            loud "Adding song from ${album} by ${artist} with selector ${SelectorName}."
            QUEUE_TIME_OFFSET=$(( QUEUE_TIME_OFFSET + length ))

            # at end to close out do-while loop
            OkayGenre="${SelectorName}"
            EMERGENCY_ROTATE=0
        else
            loud "Iteration!"
            ((counter++))
	        fi
	        if [ ${counter} -gt ${NUMSELECTORS} ];then
	            EMERGENCY_ROTATE=$(( EMERGENCY_ROTATE + 1 ))
	            rotate_songlog
	        fi
    done
    IFS=$OIFS
}



function need_next_song {
    SongFileToAdd=""
    loud "Using instruction file at ${InstructionFile}"
    #until it returns a valid match
    while [ -z "$SongFileToAdd" ];do
        choose_next_song
    done

	    SongFileToAdd=${SongFileToAdd#$MPDBASE/}
	    set_host_arg
	    `mpc --host "${host_arg}" --port "${MPD_PORT}" add "$SongFileToAdd"`
    #reset match tests
    SongFileToAdd=""
}

function main {

    rotate_songlog



    # Messy, but closes all subprocesses out
    if [ ! -f /tmp/mpdq.pid ];then
        killing
    fi

	    set_host_arg
    init_queue_time_offset

    playlist_length=$(mpc --host "$host_arg" --port "$MPD_PORT" playlist | wc -l)

    while [[ $playlist_length -lt $PLAYLIST_TRIGGER ]]; do
        need_next_song
        playlist_length=$(mpc --host "$host_arg" --port "$MPD_PORT" playlist | wc -l)
    done

# TODO - change this into an idle loop.  Since we read the instructionfile
# dynamically now, it won't matter if we point it in a different direction through
# the relay.


}

########################################################################
# Wherein we parse arguments
########################################################################
init_config

for option in "$@"; do
    case $option in
        --loud|-l)
            export LOUD=1
            ;;
        --reset|-r)
            reset_logs
            exit
            ;;
        --enumerate|-e)
            enumerate_configs
            exit
            ;;
        --help|-h)
            show_help
            exit
            ;;
        --version|-v)
            show_version
            exit
            ;;
    esac
done

read_variables


while [ $# -gt 0 ]; do
option="$1"
    case $option in
        --loud|-l)
            export LOUD=1
            shift
            ;;
        --reset|-r)
            reset_logs
            exit
            ;;
        --enumerate|-e) enumerate_configs
            exit
            ;;
        --example|-x) create_example
            exit
            ;;
        --station|-s) shift
            if [ -z "${1}" ];then
				change_station ""
            fi
				change_station "${1}"
            exit
            ;;
        --config|-c) already_running  # should abort if already running
            shift
            if [ -z "${1}" ];then
					change_station ""
                exit
            fi
            if [[ "${1}" == *"${ConfigDir}"* ]] || [[ -f "${1}" ]]; then
					set_config_file "${1}"
				else
					change_station "${1}"
				fi
            shift
            ;;
        --album-mins) shift
            if [ -z "${1}" ];then
                missing_option_argument "${option}"
            fi
            ALBUM_MINS="${1}"
            shift
            ;;
        --artist-mins) shift
            if [ -z "${1}" ];then
                missing_option_argument "${option}"
            fi
            ARTIST_MINS="${1}"
            shift
            ;;
        --help|-h)
            show_help
            exit
            ;;
        --version|-v)
            show_version
            exit
            ;;
        --force|-f)
            set_host_arg
            mpc --host "${host_arg}" --port "${MPD_PORT}" --quiet consume on
            mpc --host "${host_arg}" --port "${MPD_PORT}" --quiet random off
            shift
            ;;
        --noreplay) shift
            if [ -z "${1}" ];then
                missing_option_argument "${option}"
            fi
            NOREPLAY_ROTATE_TIME="${1}"
            shift
            ;;
        --rotate) shift
            if [ -z "${1}" ];then
                missing_option_argument "${option}"
            fi
            ROTATE_TIME="${1}"
            shift
            ;;
        *)
            unknown_option "${option}"
            ;;

    esac
done

# switch off if not set -- whoops.
set_host_arg

test_string=$(mpc --host "$host_arg" --port "$MPD_PORT" | tail -1)
# using xargs to strip whitespace here
random=$(echo "${test_string}" | awk -F 'random: ' '{print $2}' | awk '{print $1}')
repeat=$(echo "${test_string}" | awk -F 'repeat: ' '{print $2}' | awk '{print $1}')
consume=$(echo "${test_string}" | awk -F 'consume: ' '{print $2}' | awk '{print $1}')
if [ "$random" != "off" ] || [ "$repeat" != "off" ] || [ "$consume" != "on" ];then
    loud "Aborting run due to MPD settings being"
    loud "random: $random"
    loud "repeat: $repeat"
    loud "consume: $consume"
    exit 97
fi

# Normal operation, so check for already running, then write our PID
already_running
echo "$$" >> /tmp/mpdq.pid

# rotation now included in loop.

if [ ! -f "${InstructionFile}" ];then
    if [ -f "${ConfigDir}/default.cfg" ];then
        InstructionFile="${ConfigDir}/default.cfg"
    fi
fi

if [ -f "${InstructionFile}" ];then
    load_instruction_defaults
    load_instruction_settings
fi

load_choose_genre


main

rm -rf /tmp/mpdq.pid
